<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Persist only non-sensitive user preferences through Android backup. -->
        <include domain="sharedpref" path="orpheus_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow settings to follow the user during Android device migration. -->
        <include domain="sharedpref" path="orpheus_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
